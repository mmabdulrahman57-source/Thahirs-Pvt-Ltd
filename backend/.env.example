PORT=5000

# Clever Cloud MySQL — SSL is added automatically for *.clever-cloud.com hosts
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://user:password@localhost:3306/thahirs_db"

JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAIL=admin@thahirsgroup.com
ADMIN_PASSWORD=change_this_password
FRONTEND_URL=http://localhost:5173
FROM_EMAIL=noreply@thahirsgroup.com

# Email (optional — contact form still saves to DB if email fails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (required for image uploads on Vercel)
# Option A — single URL from Cloudinary Dashboard (recommended):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUDINARY_CLOUD_NAME
# Option B — separate vars (API key must have Upload permission):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: path to mysqldump for SQL backups
MYSQLDUMP_PATH=
