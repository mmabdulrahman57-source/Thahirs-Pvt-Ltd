PORT=5000

JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAIL=admin@thahirsgroup.com
ADMIN_PASSWORD=change_this_password
FRONTEND_URL=http://localhost:5173
FROM_EMAIL=noreply@thahirsgroup.com

# Email (optional — contact form still saves to DB if email fails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary — API key must have Upload permission enabled (ping alone is not enough)
CLOUDINARY_CLOUD_NAME=s1dmiu5k
CLOUDINARY_API_KEY=697335522812973
CLOUDINARY_API_SECRET=

# Optional: path to mysqldump for SQL backups
