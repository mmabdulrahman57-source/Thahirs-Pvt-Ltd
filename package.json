{
  "name": "thahirs-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "vercel-install": "npm install --prefix frontend && npm install --prefix backend",
    "vercel-build": "npm run build --prefix frontend && node scripts/copy-dist.cjs",
    "build": "npm run vercel-build",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
